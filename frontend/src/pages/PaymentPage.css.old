/* ========================================
   ANIMATION (Optional)
   ======================================== */

/* Fade in animation when voucher row appears */
@keyframes fadeInVoucher {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.summary-row.voucher-discount {
  animation: fadeInVoucher 0.4s ease-out;
}

/* ========================================
   PRINT STYLES
   ======================================== */

@media print {
  .summary-row.voucher-discount {
    background-color: transparent;
    border: 1px solid #000;
  }
  
  .summary-row.voucher-discount span {
    color: #000 !important;
  }
}

/* Amount Display Collapsible */
.amount-display-collapsible {
  background: linear-gradient(135deg, #fce4ec 0%, #f8bbd0 100%);
  border: 2px solid #e91e63;
  border-radius: 12px;
  padding: 25px;
  margin: 20px 0;
  box-shadow: 0 4px 12px rgba(233, 30, 99, 0.15);
}

.amount-header {
  text-align: center;
  margin-bottom: 15px;
}

.amount-label {
  display: block;
  color: #880e4f;
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 10px;
}

.amount-value-large {
  display: block;
  color: #c2185b;
  font-size: 36px;
  font-weight: bold;
  letter-spacing: 1px;
}

/* Toggle Button */
.toggle-details-btn {
  width: 100%;
  background: white;
  border: 1px solid #e91e63;
  color: #c2185b;
  padding: 12px 20px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.toggle-details-btn:hover {
  background: linear-gradient(135deg, #e91e63 0%, #d81b60 100%);
  color: white;
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(233, 30, 99, 0.3);
}

.toggle-details-btn.active {
  background: linear-gradient(135deg, #e91e63 0%, #d81b60 100%);
  color: white;
  border-color: #e91e63;
}

.toggle-details-btn span {
  display: flex;
  align-items: center;
  gap: 8px;
}

/* Collapsible Content */
.order-details-collapse {
  background: white;
  border-radius: 8px;
  padding: 20px;
  margin-top: 15px;
  animation: slideDown 0.3s ease;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10px 0;
  color: #2d3748;
  font-size: 14px;
}

.detail-label {
  color: #4a5568;
  font-weight: 500;
}

.detail-value {
  color: #2d3748;
  font-weight: 600;
  text-align: right;
}

.detail-value.discount {
  color: #10b981;
  font-weight: 700;
}

.detail-divider {
  height: 1px;
  background: #e2e8f0;
  margin: 10px 0;
}

.detail-row.total-row {
  padding-top: 15px;
  font-size: 16px;
  font-weight: 600;
}

.detail-row.total-row .detail-value.total {
  color: #e91e63;
  font-size: 18px;
  font-weight: bold;
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .amount-value-large {
    font-size: 28px;
  }
  
  .detail-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
  }
  
  .detail-value {
    text-align: left;
  }
}
/* ── OVO Payment Popup ───────────────────────────────────── */
.ovo-popup-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.ovo-popup-container {
  background: #fff;
  border-radius: 16px;
  width: 100%;
  max-width: 420px;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  animation: slideUp 0.25s ease;
  overflow: hidden;
}

@keyframes slideUp {
  from { transform: translateY(30px); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}

.ovo-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: linear-gradient(135deg, #4c3494, #6d4fc7);
  color: #fff;
}

.ovo-popup-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 16px;
  font-weight: 700;
}

.ovo-popup-logo {
  font-size: 20px;
}

.ovo-popup-close {
  background: rgba(255,255,255,0.2);
  border: none;
  color: #fff;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  font-size: 14px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.ovo-popup-close:hover {
  background: rgba(255,255,255,0.35);
}

.ovo-popup-body {
  flex: 1;
  overflow: hidden;
  min-height: 400px;
  position: relative;
  background: #f8f9fa;
}

.ovo-popup-iframe {
  width: 100%;
  height: 100%;
  min-height: 400px;
  border: none;
  display: block;
}

.ovo-popup-footer {
  padding: 12px 20px;
  background: #f8f9fa;
  border-top: 1px solid #e5e7eb;
  text-align: center;
}

.ovo-popup-footer p {
  font-size: 12px;
  color: #6b7280;
  margin: 0 0 8px 0;
}

.ovo-popup-fallback {
  background: none;
  border: 1px solid #4c3494;
  color: #4c3494;
  font-size: 12px;
  padding: 6px 14px;
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s;
}

.ovo-popup-fallback:hover {
  background: #4c3494;
  color: #fff;
}

/* Mobile: fullscreen popup */
@media (max-width: 480px) {
  .ovo-popup-overlay {
    padding: 0;
    align-items: flex-end;
  }
  .ovo-popup-container {
    max-width: 100%;
    max-height: 92vh;
    border-radius: 16px 16px 0 0;
  }
}

/* ── ShopeePay Button ────────────────────────────────────── */
.btn-open-payment {
  display: block;
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #ee4d2d, #f05b3a);
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  text-align: center;
  text-decoration: none;
  margin: 16px 0;
  box-shadow: 0 4px 14px rgba(238, 77, 45, 0.35);
  transition: transform 0.15s, box-shadow 0.15s;
}
.btn-open-payment:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(238, 77, 45, 0.45);
}
.btn-open-payment:active {
  transform: translateY(0);
}

/* ── OVO Button ─────────────────────────────────────────── */
.btn-ovo {
  display: block;
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #4c3494, #6d4fc7);
  color: #fff;
  font-size: 16px;
  font-weight: 700;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  text-align: center;
  margin: 16px 0;
  box-shadow: 0 4px 14px rgba(76, 52, 148, 0.35);
  transition: transform 0.15s, box-shadow 0.15s;
}
.btn-ovo:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 18px rgba(76, 52, 148, 0.45);
}
.btn-ovo:active {
  transform: translateY(0);
}

/* ── OVO Payment Popup ───────────────────────────────────── */
.ovo-popup-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  animation: ovoFadeIn 0.2s ease;
}
@keyframes ovoFadeIn {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.ovo-popup-container {
  background: #fff;
  border-radius: 16px;
  width: 100%;
  max-width: 400px;
  box-shadow: 0 20px 60px rgba(0,0,0,0.3);
  animation: ovoSlideUp 0.25s ease;
  overflow: hidden;
}
@keyframes ovoSlideUp {
  from { transform: translateY(30px); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}
.ovo-popup-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: linear-gradient(135deg, #4c3494, #6d4fc7);
  color: #fff;
}
.ovo-popup-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 16px;
  font-weight: 700;
}
.ovo-popup-logo { font-size: 20px; }
.ovo-popup-close {
  background: rgba(255,255,255,0.2);
  border: none;
  color: #fff;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  font-size: 14px;
  cursor: pointer;
  transition: background 0.2s;
}
.ovo-popup-close:hover { background: rgba(255,255,255,0.35); }

.ovo-popup-body-info {
  padding: 20px;
}
.ovo-popup-steps {
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.ovo-step {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 14px;
  color: #374151;
  line-height: 1.5;
}
.ovo-step-num {
  min-width: 26px;
  height: 26px;
  background: #4c3494;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  flex-shrink: 0;
}

.ovo-popup-footer {
  padding: 16px 20px;
  border-top: 1px solid #e5e7eb;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.ovo-btn-pay {
  width: 100%;
  padding: 14px;
  background: linear-gradient(135deg, #4c3494, #6d4fc7);
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  border: none;
  border-radius: 10px;
  cursor: pointer;
  transition: opacity 0.2s;
}
.ovo-btn-pay:hover { opacity: 0.9; }
.ovo-popup-cancel {
  width: 100%;
  padding: 10px;
  background: none;
  border: 1px solid #d1d5db;
  color: #6b7280;
  font-size: 14px;
  border-radius: 10px;
  cursor: pointer;
  transition: background 0.2s;
}
.ovo-popup-cancel:hover { background: #f9fafb; }

@media (max-width: 480px) {
  .ovo-popup-overlay {
    align-items: flex-end;
    padding: 0;
  }
  .ovo-popup-container {
    max-width: 100%;
    border-radius: 16px 16px 0 0;
  }
}