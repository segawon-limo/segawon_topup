  position: relative;
  padding: 20px;
  border: 2px solid #e2e8f0;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
  background: white;
}

.product-card:hover {
  border-color: #667eea;
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.15);
}

.product-card.selected {
  border-color: #667eea;
  background: #f0f4ff;
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
} */

.product-name {
  font-size: 16px;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 8px;
}

.product-price {
  font-size: 18px;
  color: #667eea;
  font-weight: 700;
}

.product-description {
  display: none; /* Hidden - description removed from cards */
}

.product-card .badge {
  position: absolute;
  top: 10px;
  right: 10px;
  background: #ffd700;
  color: #1a202c;
  font-size: 10px;
  font-weight: 600;
  padding: 4px 8px;
  border-radius: 8px;
  text-transform: uppercase;
}


/* ── Out of Stock ── */
.product-card.out-of-stock {
  position: relative;
  opacity: 0.55;
  cursor: not-allowed;
  background: #f7f7f7;
  border-color: #e2e8f0;
  pointer-events: none;
}

.product-card.out-of-stock:hover {
  background: #f7f7f7;
  border-color: #e2e8f0;
  color: #2d3748;
  transform: none;
  box-shadow: none;
}

.badge-oos {
  position: absolute;
  top: 8px;
  right: 8px;
  background: #ef4444;
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 3px 8px;
  border-radius: 6px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  pointer-events: none;
}

/* Ribbon wrapper — posisi di luar card supaya ribbon menonjol di atas */
.ribbon-wrapper {
  position: absolute;
  top: -9px;
  right: -6px;
  width: 90px;
  height: 90px;
  overflow: hidden;
  pointer-events: none;
  z-index: 20;
}

/* Ribbon strip diagonal */
.ribbon-badge {
  position: absolute;
  top: 18px;
  right: -22px;
  width: 100px;
  background: linear-gradient(180deg, #e53e3e 0%, #c53030 100%);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  text-align: center;
  padding: 5px 0;
  letter-spacing: 0.04em;
  transform: rotate(45deg);
  box-shadow: 0 3px 8px rgba(0,0,0,0.3),
              inset 0 1px 0 rgba(255,255,255,0.2);
}

/* Tekukan atas */
.ribbon-badge::before {
  content: '';
  position: absolute;
  bottom: -5px;
  left: 0;
  border-left: 5px solid #7b1a1a;
  border-bottom: 5px solid transparent;
}

/* Tekukan kanan */
.ribbon-badge::after {
  content: '';
  position: absolute;
  bottom: -5px;
  right: 0;
  border-right: 5px solid #7b1a1a;
  border-bottom: 5px solid transparent;
}

.product-price-compare {
  display: block;
  font-size: 11px;
  color: #a0aec0;
  text-decoration: line-through;
  margin-bottom: 2px;
  font-weight: 400;
}

.oos-price {
  color: #a0aec0;
  text-decoration: line-through;
  font-weight: 600;
}

/* Form Groups */
.form-group {
  margin-bottom: 20px;
}

.form-group label {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 8px;
}

.form-group input,
.form-group select {
  width: 100%;
  padding: 12px 16px;
  border: 2px solid #e2e8f0;
  border-radius: 8px;
  font-size: 14px;
  transition: all 0.3s ease;
}

.form-group input:focus,
.form-group select:focus {
  outline: none;
  border-color: #667eea;
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.form-group input.error {
  border-color: #f56565;
}

.form-group small {
  display: block;
  margin-top: 4px;
  font-size: 12px;
  color: #718096;
}

.error {
  color: #f56565;
  font-size: 12px;
  margin-top: 4px;
}

/* Submit Button */
.btn-submit {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
}

.btn-submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
}

.btn-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

/* ===== ORDER SUMMARY - STICKY WITH SCROLL ===== */
/* High specificity untuk override cache */
.order-page .order-layout .order-summary {
  position: sticky !important;
  top: 80px !important;
  align-self: flex-start !important;
  
  max-height: calc(100vh - 100px) !important;
  min-height: 300px;
  
  background: white;
  border-radius: 12px;
  padding: 24px;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  
  overflow-y: auto !important;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
}

/* Custom scrollbar */
.order-summary::-webkit-scrollbar {
  width: 6px;
}

.order-summary::-webkit-scrollbar-track {
  background: #f1f5f9;
  border-radius: 10px;
}

.order-summary::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 10px;
}

.order-summary::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}

.order-summary {
  scrollbar-width: thin;
  scrollbar-color: #cbd5e1 #f1f5f9;
}

/* Summary header */
.order-summary h3 {
  margin: 0 0 20px 0;
  padding: 0 0 16px 0; 
  font-size: 20px;
  font-weight: 700;
  color: #1e293b;
  border-bottom: 2px solid #e2e8f0;
}

/* Summary items */
.summary-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  font-size: 14px;
  color: #475569;
  border-bottom: 1px solid #f1f5f9;
}

.summary-item:last-of-type {
  border-bottom: none;
}

.summary-item span:first-child {
  color: #64748b;
  font-weight: 500;
}

.summary-item span:last-child {
  font-weight: 600;
  color: #2d3748;
  text-align: right;
}

.summary-item .fee-amount {
  color: #f59e0b;
  font-weight: 700;
}

/* Divider */
.summary-divider {
  height: 2px;
  background: linear-gradient(to right, #e2e8f0, #cbd5e1, #e2e8f0);
  margin: 16px 0;
}

/* Total section */
.summary-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0 8px 0;
  font-size: 16px;
  font-weight: 700;
  color: #2d3748;
}

.total-price {
  font-size: 24px !important;
  color: #667eea !important;
  font-weight: 800 !important;
}

/* Note */
.summary-note {
  text-align: center;
  font-size: 12px;
  color: #718096;
  margin-top: 8px;
  padding-bottom: 16px;
}

/* Submit Button in Summary */
.order-summary .btn-submit {
  width: 100%;
  padding: 16px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 12px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
  margin-top: 8px;
}

.order-summary .btn-submit:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
}

.order-summary .btn-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

/* Placeholder */
.summary-placeholder {
  text-align: center;
  padding: 40px 20px;
  color: #a0aec0;
  font-size: 14px;
}

/* Loading */
.loading {
  text-align: center;
  padding: 60px 20px;
  font-size: 18px;
  color: #718096;
}

/* Validation Button */
.btn-validate {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  padding: 14px 24px;
  border: none;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
  cursor: pointer;
  margin-top: 16px;
  transition: all 0.3s ease;
  box-shadow: 0 4px 12px rgba(102, 126, 234, 0.2);
}

.btn-validate:hover:not(:disabled) {
  background: linear-gradient(135deg, #5568d3 0%, #6a3f8f 100%);
  transform: translateY(-2px);
  box-shadow: 0 6px 16px rgba(102, 126, 234, 0.3);
}

.btn-validate:disabled {
  background: #cbd5e0;
  cursor: not-allowed;
}

/* Success Message */
.success {
  background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
  border: 2px solid #28a745;
  color: #155724;
  padding: 16px 20px;
  border-radius: 12px;
  margin-top: 16px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-weight: 600;
  box-shadow: 0 4px 12px rgba(40, 167, 69, 0.15);
}

.btn-change {
  background: white;
  color: #28a745;
  border: 2px solid #28a745;
  padding: 8px 20px;
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  margin-left: 12px;
}

.btn-change:hover {
  background: #28a745;
  color: white;
  transform: scale(1.05);
}

input:disabled {
  background-color: #f0f2f5;
  color: #6c757d;
  cursor: not-allowed;
  opacity: 0.7;
}

/* Payment Methods */
.payment-methods {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

/* ── Accordion ── */
.payment-accordion {
  border: 2px solid #e2e8f0;
  border-radius: 12px;
  overflow: hidden;
  transition: border-color 0.2s ease;
}

.payment-accordion.open {
  border-color: #667eea;
}

.accordion-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  background: #f8faff;
  border: none;
  cursor: pointer;
  font-size: 15px;
  font-weight: 600;
  color: #2d3748;
  transition: background 0.2s ease;
  text-align: left;
}

.accordion-header:hover {
  background: #eef2ff;
}

.payment-accordion.open .accordion-header {
  background: linear-gradient(135deg, #eef2ff 0%, #e8ecff 100%);
  color: #4c51bf;
  border-bottom: 1px solid #c7d2fe;
}

.accordion-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.accordion-selected-badge {
  font-size: 12px;
  font-weight: 500;
  background: #667eea;
  color: white;
  padding: 2px 8px;
  border-radius: 20px;
}

.accordion-chevron {
  font-size: 11px;
  color: #667eea;
  transition: transform 0.2s ease;
}

.accordion-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
  padding: 12px;
  background: white;
}

.payment-category {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.payment-category h3 {
  font-size: 16px;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 8px;
  padding-bottom: 8px;
  border-bottom: 1px solid #e2e8f0;
}

.payment-option {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 16px 20px;
  border: 2px solid #e2e8f0;
  border-radius: 12px;
  cursor: pointer;
  transition: all 0.3s ease;
  background: white;
}

.payment-option:hover {
  border-color: #667eea;
  background: #f0f4ff;
  transform: translateX(4px);
}

.payment-option.selected {
  border-color: #667eea;
  background: linear-gradient(135deg, #f0f4ff 0%, #e8ecff 100%);
  box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}

.payment-option input[type="radio"] {
  width: 20px;
  height: 20px;
  cursor: pointer;
  accent-color: #667eea;
  flex-shrink: 0;
}

.payment-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  flex: 1;
}

.payment-name {
  font-size: 15px;
  font-weight: 600;
  color: #2d3748;
}

.payment-note {
  font-size: 12px;
  color: #718096;
  font-weight: 500;
}

/* Responsive */
@media (max-width: 1024px) {
  .order-layout {
    grid-template-columns: 1fr;
  }
  
  .order-page .order-layout .order-summary {
    position: relative !important;
    top: auto !important;
    max-height: none !important;
    order: 2;
    margin-top: 30px;
  }
}

@media (max-width: 768px) {
  .order-page {
    padding: 0;
  }

  .game-header-image {
    top: 60px;
    height: 45vh;
  }

  .order-page .container {
    padding-top: calc(60px + 45vh + 20px);
    padding-left: 10px;
    padding-right: 10px;
  }

  .page-title {
    font-size: 24px;
  }

  .page-title-wrapper {
    gap: 14px;
  }

  .game-icon-box {
    width: 60px;
    height: 60px;
    border-radius: 12px;
  }

  .payment-logo {
    width: 44px;
    height: 26px;
  }

  .order-form,
  .order-summary {
    padding: 20px;
  }

  .products-grid {
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }

  .product-card {
    padding: 15px;
  }

  .payment-option {
    padding: 14px 16px;
  }

  .payment-name {
    font-size: 14px;
  }
}

/* Mobile adjustments */
@media (max-width: 1024px) {
  .order-summary {
    margin-top: 30px;
  }
}

@media (max-width: 768px) {
  .order-summary {
    padding: 20px;
  }
  
  .order-summary h3 {
    font-size: 18px;
    margin: 0 0 16px 0;
    padding: 0 0 12px 0;
  }
}
/* ========================================
   VOUCHER SECTION STYLES
   ======================================== */

/* Voucher Section Container */
.voucher-section {
  background: linear-gradient(135deg, #f8f9ff 0%, #f0f4ff 100%);
  border: 2px dashed #a5b4fc;
  border-radius: 12px;
  padding: 25px !important;
  margin-bottom: 30px;
}

.voucher-section h2 {
  color: #4f46e5;
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 15px;
  padding-bottom: 12px;
  border-bottom: 2px solid #c7d2fe;
}

/* Voucher Input Group */
.voucher-input-group {
  display: flex;
  gap: 10px;
  align-items: stretch;
}

.voucher-input-group input {
  flex: 1;
  padding: 12px 16px;
  border: 2px solid #e0e7ff;
  border-radius: 8px;
  font-size: 15px;
  font-weight: 600;
  text-transform: uppercase;
  transition: all 0.3s ease;
  background: white;
}

.voucher-input-group input:focus {
  outline: none;
  border-color: #6366f1;
  box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
}

.voucher-input-group input.error {
  border-color: #ef4444;
  background: #fef2f2;
}

.voucher-input-group input.success {
  border-color: #10b981;
  background: #f0fdf4;
}

.voucher-input-group input:disabled {
  background: #f9fafb;
  cursor: not-allowed;
}

/* Voucher Buttons */
.btn-apply-voucher,
.btn-remove-voucher {
  padding: 12px 24px;
  border: none;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
  white-space: nowrap;
}

.btn-apply-voucher {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: white;
}

.btn-apply-voucher:hover:not(:disabled) {
  background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px rgba(99, 102, 241, 0.4);
}

.btn-apply-voucher:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.btn-remove-voucher {
  background: #fee2e2;
  color: #dc2626;
}

.btn-remove-voucher:hover {
  background: #fecaca;
  transform: translateY(-2px);
}

/* Voucher Messages */
.voucher-error {
  margin-top: 12px;
  padding: 12px 16px;
  background: #fef2f2;
  border-left: 4px solid #ef4444;
  border-radius: 6px;
  color: #dc2626;
  font-size: 14px;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 8px;
}

.voucher-success {
  margin-top: 12px;
  padding: 12px 16px;
  background: #f0fdf4;
  border-left: 4px solid #10b981;
  border-radius: 6px;
  color: #059669;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 8px;
  animation: slideDown 0.3s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Voucher Discount in Summary */
.summary-item.voucher-discount {
  background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
  padding: 12px;
  margin: 10px 0;
  border-radius: 8px;
  border-left: 4px solid #10b981;
}

.summary-item.voucher-discount span:first-child {
  color: #059669;
  font-weight: 600;
}

/* Responsive Voucher Styles */
@media (max-width: 768px) {
  .voucher-section {
    padding: 20px !important;
  }

  .voucher-input-group {
    flex-direction: column;
  }

  .btn-apply-voucher,
  .btn-remove-voucher {
    width: 100%;
  }
}

/* Voucher product notice (Steam Wallet, dll — tidak perlu User ID) */
.voucher-info-section {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 12px;
  padding: 20px 24px;
}

.voucher-notice {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.voucher-notice span {
  font-size: 24px;
  flex-shrink: 0;
  line-height: 1;
}

.voucher-notice p {
  color: #166534;
  font-size: 14px;
  line-height: 1.6;
  margin: 0;
}

/* ── PLN Cek Nomor Meter Result Card ── */
.pln-check-result {
  background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
  border: 2px solid #22c55e;
  border-radius: 12px;
  padding: 16px 20px;
  margin-top: 16px;
}

.pln-check-header {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  font-weight: 700;
  color: #166534;
  margin-bottom: 14px;
  padding-bottom: 10px;
  border-bottom: 1px solid #bbf7d0;
}

.pln-check-icon {
  font-size: 18px;
}

.pln-check-rows {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-bottom: 14px;
}

.pln-check-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  font-size: 14px;
  gap: 12px;
}

.pln-check-label {
  color: #4b7c59;
  font-weight: 500;
  flex-shrink: 0;
}

.pln-check-value {
  color: #14532d;
  font-weight: 700;
  text-align: right;
  word-break: break-word;
}

/* ── Payment Coming Soon ── */
.payment-category-disabled {
  opacity: 0.55;
}

.payment-option-disabled {
  cursor: not-allowed;
  background: #f9fafb;
  border: 1px dashed #d1d5db;
  border-radius: 8px;
  padding: 12px 16px;
}

.coming-soon-text {
  color: #9ca3af;
  font-style: italic;
}

.badge-coming-soon-inline {
  display: inline-block;
  margin-left: 8px;
  padding: 2px 8px;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 11px;
  font-weight: 600;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  vertical-align: middle;
}

/* ── Product card icon ── */
.product-name {
  display: flex;
  align-items: center;
  gap: 8px;
}

.product-card-icon {
  width: 28px;
  height: 28px;
  object-fit: contain;
  border-radius: 6px;
  flex-shrink: 0;
}
.info-box-ovo {
  margin-top: 8px;
  padding: 10px 14px;
  background: #fff8e1;
  border: 1px solid #f9a825;
  border-radius: 8px;
  font-size: 13px;
  color: #5d4037;
  line-height: 1.5;
}

/* ── end ─────────────────────────────────────────────── */