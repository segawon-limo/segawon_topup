/* ===================================================
   PascabayarPage — Segawon Topup
   Reuses: .form-group, .form-input, .order-summary,
           .summary-item, .summary-total, .summary-divider,
           .voucher-input-group, .voucher-error, .voucher-success,
           .btn-apply-voucher, .btn-remove-voucher, .payment-logo
           (dari OrderPage.css via shared class names)
   =================================================== */

@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap');

/* ── Provider Grid ── */
.pb-provider-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
  margin-bottom: 4px;
}
.pb-provider-card {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  padding: 20px 16px;
  border: 2px solid #e2e8f0;
  border-radius: 14px;
  background: #fafafa;
  cursor: pointer;
  transition: all 0.2s;
  text-align: center;
  font-family: 'DM Sans', sans-serif;
}
.pb-provider-card:hover {
  border-color: var(--provider-color, #c0392b);
  background: white;
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.08);
}
.pb-provider-selected {
  border-color: var(--provider-color, #c0392b) !important;
  background: white !important;
  box-shadow: 0 0 0 3px rgba(192,57,43,0.1), 0 4px 16px rgba(0,0,0,0.08) !important;
}
.pb-provider-logo-wrap {
  width: 72px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.pb-provider-logo {
  max-width: 72px;
  max-height: 48px;
  object-fit: contain;
}
.pb-provider-logo-fallback {
  display: none;
  width: 56px;
  height: 56px;
  border-radius: 12px;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 22px;
  font-weight: 800;
  font-family: 'Syne', sans-serif;
}
.pb-provider-name {
  font-size: 15px;
  font-weight: 700;
  color: #1a202c;
  font-family: 'Syne', sans-serif;
}
.pb-provider-desc {
  font-size: 11px;
  color: #a0aec0;
  line-height: 1.4;
}
.pb-provider-check {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: var(--provider-color, #c0392b);
  color: white;
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pb-provider-input-wrap {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 2px solid #f0f0f0;
  animation: pb-slide-down 0.2s ease;
}
@keyframes pb-slide-down {
  from { opacity: 0; transform: translateY(-8px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── Page wrapper ── */
.pb-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 80px 20px 60px;
  font-family: 'DM Sans', sans-serif;
  position: relative;
  overflow: hidden;
  color: #1a202c;
}

/* ── Background blobs ── */
.pb-blob {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.09;
  pointer-events: none;
  z-index: 0;
}
.pb-blob-1 { width: 500px; height: 500px; background: #c0392b; top: -150px; left: -150px; }
.pb-blob-2 { width: 350px; height: 350px; background: #e74c3c; bottom: -100px; right: -80px; }

/* ── Outer container ── */
.pb-outer {
  position: relative;
  z-index: 1;
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* ── Back button ── */
.pb-back {
  background: none;
  border: none;
  color: #718096;
  font-size: 14px;
  cursor: pointer;
  padding: 0;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: color 0.2s;
  font-family: 'DM Sans', sans-serif;
}
.pb-back:hover { color: #c0392b; }

/* ── Header card ── */
.pb-header {
  background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%);
  border-radius: 16px;
  padding: 36px 28px;
  text-align: center;
  color: white;
  box-shadow: 0 8px 30px rgba(192, 57, 43, 0.25);
}
.pb-header-icon  { font-size: 48px; margin-bottom: 12px; line-height: 1; }
.pb-header-title { font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 700; margin: 0 0 8px; }
.pb-header-sub   { font-size: 14px; opacity: 0.9; margin: 0; }

/* ── Stepper ── */
.pb-stepper {
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 12px;
  padding: 20px 32px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}
.pb-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
}
.pb-step-circle {
  width: 32px; height: 32px;
  border-radius: 50%;
  background: #e2e8f0;
  color: #a0aec0;
  display: flex; align-items: center; justify-content: center;
  font-size: 13px; font-weight: 700;
  transition: all 0.3s;
}
.pb-step-active .pb-step-circle { background: #c0392b; color: white; }
.pb-step-done   .pb-step-circle { background: #16a34a; color: white; }
.pb-step-label  { font-size: 11px; color: #a0aec0; font-weight: 500; white-space: nowrap; }
.pb-step-active .pb-step-label,
.pb-step-done   .pb-step-label { color: #1a202c; }
.pb-step-line      { flex: 1; height: 2px; background: #e2e8f0; margin: 0 12px; margin-bottom: 18px; transition: background 0.3s; }
.pb-step-line-done { background: #16a34a; }

/* ── Card ── */
.pb-card {
  background: white;
  border-radius: 16px;
  padding: 28px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  border: 1px solid #f0f0f0;
}
.pb-card-center { max-width: 620px; margin: 0 auto; width: 100%; }
.pb-card-tagihan { border-left: 4px solid #c0392b; }
.pb-card-title {
  font-family: 'Syne', sans-serif;
  font-size: 18px; font-weight: 700;
  color: #1a202c; margin: 0 0 6px;
}
.pb-card-desc {
  font-size: 14px; color: #718096;
  margin: 0 0 24px; line-height: 1.6;
}
.pb-optional { font-size: 13px; font-weight: 400; color: #a0aec0; }

/* ── Info rows (tagihan detail) ── */
.pb-info-rows { display: flex; flex-direction: column; }
.pb-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 11px 0;
  border-bottom: 1px solid #f7f7f7;
  gap: 12px;
}
.pb-info-row:last-child { border-bottom: none; }
.pb-info-key { font-size: 13px; color: #718096; flex-shrink: 0; }
.pb-info-val { font-size: 14px; font-weight: 500; color: #2d3748; text-align: right; }
.pb-detail-row .pb-info-key { padding-left: 12px; color: #a0aec0; font-style: italic; }
.pb-info-row-total {
  margin-top: 6px;
  padding-top: 14px;
  border-top: 2px solid #f0f0f0;
  border-bottom: none;
}
.pb-price-red { font-size: 18px; font-weight: 700; color: #c0392b; }

/* ── Form fields — extend OrderPage .form-group ── */
.pb-left .form-group { margin-bottom: 20px; }
.pb-left .form-group label,
.form-label {
  display: block;
  font-size: 14px; font-weight: 600;
  color: #2d3748; margin-bottom: 8px;
}
.pb-left .form-input,
.form-input {
  width: 100%;
  padding: 12px 16px;
  border: 2px solid #e2e8f0;
  border-radius: 8px;
  font-size: 14px;
  font-family: 'DM Sans', sans-serif;
  color: #1a202c;
  background: #fafafa;
  transition: border-color 0.2s, box-shadow 0.2s;
  box-sizing: border-box;
}
.pb-left .form-input:focus,
.form-input:focus {
  outline: none;
  border-color: #c0392b;
  box-shadow: 0 0 0 3px rgba(192,57,43,0.1);
  background: white;
}
.pb-left .form-input.error,
.form-input.error { border-color: #f56565; background: #fff5f5; }
.pb-left .form-input.success,
.form-input.success { border-color: #10b981; background: #f0fdf4; }
.form-hint { display: block; font-size: 12px; color: #a0aec0; margin-top: 5px; }
.required-star { color: #c0392b; }

/* ── Payment options ── */
.pb-payment-group-label {
  font-size: 12px; font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.8px;
  color: #a0aec0; margin: 0 0 10px;
}
.pb-payment-list { display: flex; flex-direction: column; gap: 8px; }
.pb-payment-option {
  display: flex; align-items: center; gap: 12px;
  padding: 12px 16px;
  border: 2px solid #e2e8f0;
  border-radius: 10px;
  cursor: pointer;
  transition: all 0.2s;
  background: #fafafa;
}
.pb-payment-option:hover { border-color: #c0392b; background: #fff5f5; }
.pb-payment-option.selected {
  border-color: #c0392b;
  background: #fff5f5;
  box-shadow: 0 0 0 3px rgba(192,57,43,0.08);
}
.pb-payment-option input[type="radio"] {
  accent-color: #c0392b;
  width: 16px; height: 16px; flex-shrink: 0;
}
.pb-payment-name { flex: 1; font-size: 14px; font-weight: 500; color: #2d3748; }
.pb-payment-fee  {
  font-size: 12px; color: #718096;
  background: #f7f7f7; padding: 3px 8px;
  border-radius: 20px; white-space: nowrap;
}

/* ── Error box ── */
.pb-error-box {
  background: #fff5f5;
  border: 1px solid #fed7d7;
  border-radius: 10px;
  padding: 12px 16px;
  font-size: 14px; color: #c0392b;
}

/* ── Action buttons ── */
.pb-actions { display: flex; gap: 12px; }
.pb-btn-primary {
  flex: 2;
  padding: 15px;
  background: linear-gradient(135deg, #c0392b 0%, #e74c3c 100%);
  color: white; border: none; border-radius: 12px;
  font-size: 16px; font-weight: 700;
  font-family: 'DM Sans', sans-serif;
  cursor: pointer; transition: all 0.2s;
  box-shadow: 0 4px 15px rgba(192,57,43,0.3);
}
.pb-btn-primary:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(192,57,43,0.4);
}
.pb-btn-primary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }
/* Solo button (step 1) */
.pb-card-center .pb-btn-primary { flex: unset; width: 100%; }

.pb-btn-secondary {
  flex: 1;
  padding: 14px; background: white;
  color: #718096; border: 2px solid #e2e8f0;
  border-radius: 12px; font-size: 15px; font-weight: 600;
  font-family: 'DM Sans', sans-serif; cursor: pointer; transition: all 0.2s;
}
.pb-btn-secondary:hover { border-color: #c0392b; color: #c0392b; }

/* ── Two-column layout (confirm step) ── */
.pb-layout {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 24px;
  align-items: start;
}
.pb-left  { display: flex; flex-direction: column; gap: 20px; }
.pb-right .order-summary {
  position: sticky;
  top: 80px;
  background: white;
  border-radius: 16px;
  padding: 28px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
  border: 1px solid #f0f0f0;
  max-height: calc(100vh - 100px);
  overflow-y: auto;
}

/* ── Responsive ── */
@media (max-width: 900px) {
  .pb-layout { grid-template-columns: 1fr; }
  .pb-right .order-summary { position: static; }
}
@media (max-width: 480px) {
  .pb-page    { padding: 70px 16px 40px; }
  .pb-card    { padding: 20px; }
  .pb-header  { padding: 28px 20px; }
  .pb-header-title { font-size: 22px; }
  .pb-stepper { padding: 16px; }
  .pb-step-label { font-size: 10px; }
  .pb-actions { flex-direction: column; }
  .pb-btn-primary, .pb-btn-secondary { flex: unset; width: 100%; }
  .pb-provider-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
  .pb-provider-card { padding: 16px 10px; }
  .pb-provider-name { font-size: 13px; }
}