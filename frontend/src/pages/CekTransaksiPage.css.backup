/* ===================================================
   CekTransaksiPage — Segawon Topup
   Theme: merah-putih konsisten dengan homepage
   =================================================== */

@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@400;500;600&display=swap');

.ct-page {
  min-height: 100vh;
  background: #f8f9fa;
  padding: 80px 20px 60px;
  font-family: 'DM Sans', sans-serif;
  position: relative;
  overflow: hidden;
  color: #1a202c;
}

/* ── Background decorative ── */
.ct-blob {
  position: fixed;
  border-radius: 50%;
  filter: blur(80px);
  opacity: 0.12;
  pointer-events: none;
  z-index: 0;
}
.ct-blob-1 {
  width: 500px; height: 500px;
  background: #c0392b;
  top: -150px; left: -150px;
}
.ct-blob-2 {
  width: 350px; height: 350px;
  background: #e74c3c;
  bottom: -100px; right: -80px;
}

/* ── Container ── */
.ct-container {
  position: relative;
  z-index: 1;
  max-width: 680px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* ── Header ── */
.ct-back {
  background: none;
  border: none;
  color: #718096;
  font-size: 14px;
  cursor: pointer;
  padding: 0;
  margin-bottom: 16px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  transition: color 0.2s;
  font-family: 'DM Sans', sans-serif;
}
.ct-back:hover { color: #c0392b; }

.ct-header {
  text-align: center;
  padding-bottom: 8px;
}
.ct-logo {
  font-size: 48px;
  margin-bottom: 12px;
  display: block;
}
.ct-title {
  font-family: 'Syne', sans-serif;
  font-size: 32px;
  font-weight: 800;
  color: #1a202c;
  margin: 0 0 8px;
  letter-spacing: -0.5px;
}
.ct-subtitle {
  color: #718096;
  font-size: 15px;
  margin: 0;
}

/* ── Search Card ── */
.ct-search-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}
.ct-label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #718096;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 10px;
}
.ct-search-row {
  display: flex;
  gap: 10px;
}
.ct-input {
  flex: 1;
  background: #f7fafc;
  border: 1.5px solid #e2e8f0;
  border-radius: 10px;
  padding: 13px 16px;
  font-size: 15px;
  color: #1a202c;
  font-family: 'DM Sans', sans-serif;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  letter-spacing: 0.03em;
}
.ct-input::placeholder { color: #a0aec0; }
.ct-input:focus {
  border-color: #c0392b;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(192,57,43,0.1);
}
.ct-search-btn {
  background: linear-gradient(135deg, #c0392b, #e74c3c);
  border: none;
  border-radius: 10px;
  padding: 13px 22px;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: opacity 0.2s, transform 0.1s, box-shadow 0.2s;
  font-family: 'DM Sans', sans-serif;
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 100px;
  justify-content: center;
  box-shadow: 0 4px 12px rgba(192,57,43,0.3);
}
.ct-search-btn:hover:not(:disabled) {
  opacity: 0.92;
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(192,57,43,0.35);
}
.ct-search-btn:disabled { opacity: 0.5; cursor: not-allowed; box-shadow: none; }

.ct-spinner {
  width: 16px; height: 16px;
  border: 2px solid rgba(255,255,255,0.4);
  border-top-color: #fff;
  border-radius: 50%;
  animation: ct-spin 0.7s linear infinite;
}
@keyframes ct-spin { to { transform: rotate(360deg); } }

.ct-hint {
  font-size: 12px;
  color: #a0aec0;
  margin: 10px 0 0;
}

/* ── Error ── */
.ct-error-card {
  background: #fff5f5;
  border: 1px solid #fed7d7;
  border-radius: 12px;
  padding: 20px 24px;
  display: flex;
  align-items: center;
  gap: 14px;
  color: #c53030;
  font-size: 15px;
  animation: ct-fadein 0.3s ease;
}
.ct-error-icon { font-size: 24px; }

/* ── Result ── */
.ct-result {
  display: flex;
  flex-direction: column;
  gap: 14px;
  animation: ct-fadein 0.4s ease;
}
@keyframes ct-fadein {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── Status Banner ── */
.ct-status-banner {
  border: 1.5px solid;
  border-radius: 14px;
  padding: 18px 22px;
  display: flex;
  align-items: center;
  gap: 16px;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}
.ct-status-icon { font-size: 32px; }
.ct-status-label {
  font-family: 'Syne', sans-serif;
  font-size: 18px;
  font-weight: 700;
}
.ct-status-invoice {
  font-size: 13px;
  color: #718096;
  margin-top: 2px;
  font-family: monospace;
  letter-spacing: 0.05em;
}

/* ── Info Grid ── */
.ct-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}
@media (max-width: 540px) {
  .ct-info-grid { grid-template-columns: 1fr; }
}

/* ── Cards ── */
.ct-card {
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 14px;
  padding: 18px 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.04);
}
.ct-timeline-card { grid-column: 1 / -1; }
.ct-card-title {
  font-size: 13px;
  font-weight: 600;
  color: #718096;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 14px;
}
.ct-info-rows {
  display: flex;
  flex-direction: column;
  gap: 10px;
}
.ct-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  font-size: 14px;
}
.ct-info-key { color: #a0aec0; flex-shrink: 0; padding-top: 1px; }
.ct-info-val { color: #2d3748; font-weight: 500; text-align: right; word-break: break-all; }
.ct-mono { font-family: monospace; letter-spacing: 0.04em; }
.ct-highlight {
  color: #276749;
  background: #f0fff4;
  border: 1px solid #c6f6d5;
  padding: 2px 8px;
  border-radius: 6px;
  font-size: 13px;
}
.ct-total-row {
  border-top: 1px solid #e2e8f0;
  padding-top: 10px;
  margin-top: 4px;
}
.ct-total {
  color: #c0392b;
  font-family: 'Syne', sans-serif;
  font-size: 16px;
  font-weight: 700;
}
.ct-expires { color: #c05621; }

/* ── Actions ── */
.ct-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}
.ct-btn-pay {
  flex: 1;
  background: linear-gradient(135deg, #276749, #38a169);
  border: none;
  border-radius: 10px;
  padding: 13px 20px;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  text-align: center;
  transition: opacity 0.2s, transform 0.1s;
  font-family: 'DM Sans', sans-serif;
  box-shadow: 0 4px 12px rgba(56,161,105,0.3);
}
.ct-btn-pay:hover { opacity: 0.9; transform: translateY(-1px); }

.ct-btn-wa {
  flex: 1;
  background: linear-gradient(135deg, #1a7a3c, #25d366);
  border: none;
  border-radius: 10px;
  padding: 13px 20px;
  color: #fff;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  text-align: center;
  transition: opacity 0.2s, transform 0.1s;
  font-family: 'DM Sans', sans-serif;
  box-shadow: 0 4px 12px rgba(37,211,102,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.ct-btn-wa:hover { opacity: 0.9; transform: translateY(-1px); }
.ct-wa-icon { font-size: 16px; }

.ct-btn-secondary {
  flex: 1;
  background: #fff;
  border: 1.5px solid #e2e8f0;
  border-radius: 10px;
  padding: 13px 20px;
  color: #4a5568;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  text-align: center;
  transition: border-color 0.2s, color 0.2s, background 0.2s;
  font-family: 'DM Sans', sans-serif;
  white-space: nowrap;
}
.ct-btn-secondary:hover {
  border-color: #c0392b;
  color: #c0392b;
  background: #fff5f5;
}
/* ── Payment Modal ─────────────────────────────────────── */
.ct-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.55);
  backdrop-filter: blur(4px);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  animation: ct-fade-in 0.2s ease;
}

@keyframes ct-fade-in {
  from { opacity: 0; }
  to   { opacity: 1; }
}

.ct-modal {
  background: #fff;
  border-radius: 20px;
  width: 100%;
  max-width: 420px;
  padding: 28px 24px 24px;
  position: relative;
  box-shadow: 0 20px 60px rgba(0,0,0,0.25);
  animation: ct-slide-up 0.25s ease;
}

@keyframes ct-slide-up {
  from { transform: translateY(30px); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}

.ct-modal-close {
  position: absolute;
  top: 16px;
  right: 16px;
  background: #f1f5f9;
  border: none;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  font-size: 14px;
  cursor: pointer;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}
.ct-modal-close:hover { background: #e2e8f0; }

.ct-modal-header {
  margin-bottom: 16px;
}
.ct-modal-title {
  font-size: 18px;
  font-weight: 700;
  color: #1e293b;
}
.ct-modal-subtitle {
  font-size: 13px;
  color: #64748b;
  margin-top: 2px;
}

.ct-modal-amount {
  background: linear-gradient(135deg, #667eea, #764ba2);
  border-radius: 12px;
  padding: 14px 18px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20px;
  color: white;
}
.ct-modal-amount-label { font-size: 13px; opacity: 0.85; }
.ct-modal-amount-value { font-size: 20px; font-weight: 700; }

/* QRIS */
.ct-modal-qris {
  text-align: center;
  margin-bottom: 16px;
}
.ct-modal-qr-img {
  width: 220px;
  height: 220px;
  border-radius: 12px;
  border: 3px solid #e2e8f0;
  display: block;
  margin: 10px auto;
}
.ct-modal-hint {
  font-size: 13px;
  color: #475569;
  margin-bottom: 6px;
}
.ct-modal-hint-small {
  font-size: 11px;
  color: #94a3b8;
  margin-top: 8px;
}
.ct-modal-loading {
  padding: 40px 0;
  text-align: center;
  color: #94a3b8;
  font-size: 14px;
}

/* VA */
.ct-modal-va {
  margin-bottom: 16px;
}
.ct-modal-va-box {
  display: flex;
  align-items: center;
  gap: 10px;
  background: #f8faff;
  border: 2px solid #c7d2fe;
  border-radius: 10px;
  padding: 12px 16px;
  margin: 8px 0 12px;
}
.ct-modal-va-number {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 2px;
  color: #1e293b;
  flex: 1;
}
.ct-modal-copy-btn {
  background: #667eea;
  color: white;
  border: none;
  border-radius: 8px;
  padding: 6px 12px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  white-space: nowrap;
  transition: background 0.2s;
}
.ct-modal-copy-btn:hover { background: #5a67d8; }
.ct-modal-copy-btn.copied { background: #10b981; }

.ct-modal-va-steps {
  font-size: 13px;
  color: #475569;
  line-height: 1.8;
}
.ct-modal-va-steps ol {
  margin: 6px 0 0 16px;
  padding: 0;
}

.ct-modal-open-btn {
  display: block;
  text-align: center;
  background: #667eea;
  color: white;
  border-radius: 10px;
  padding: 12px;
  font-weight: 600;
  text-decoration: none;
  margin-top: 8px;
}

.ct-modal-expiry {
  font-size: 12px;
  color: #94a3b8;
  text-align: center;
  padding-top: 12px;
  border-top: 1px solid #f1f5f9;
  margin-top: 4px;
}